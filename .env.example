# ============================================================
# vibe-platform 本地开发环境变量
# 复制为 .env 后按需修改；.env 不提交 Git
# ============================================================

# ---- 运行环境 ----
APP_ENV=local

# ---- MySQL（复用 ~/Workspace/infra 的 Docker 实例） ----
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=geo_ai_db
MYSQL_USER=root
MYSQL_PASSWORD=root

# ---- Redis（复用 ~/Workspace/infra 的 Docker 实例） ----
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- MinIO（复用 ~/Workspace/infra 的 Docker 实例） ----
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=vibe-platform
MINIO_SECURE=false

# ---- AI Core ----
AI_CORE_BASE_URL=http://python-ai:8100
AI_CORE_CONNECT_TIMEOUT_MS=2000
AI_CORE_READ_TIMEOUT_MS=3000
# Run 同步执行：模型 + 沙盒构建 + 最多 3 次修复。
AI_CORE_RUN_CONNECT_TIMEOUT_MS=2000
AI_CORE_RUN_READ_TIMEOUT_MS=300000

# ---- Sandbox ----
# 宿主 docker 组 GID：Linux 执行 `stat -c '%g' /var/run/docker.sock` 获取。
# Docker Desktop / Windows 通常无需修改，保持 0 以外的默认值即可。
DOCKER_GID=115
SANDBOX_IMAGE=vibe-platform/sandbox-react:dev
# 浏览器访问预览端口时使用的主机名；M1 单机本地开发用 127.0.0.1。
SANDBOX_PREVIEW_HOST=127.0.0.1
SANDBOX_MEMORY_MB=768
SANDBOX_CPU_LIMIT=1.0
SANDBOX_START_TIMEOUT_SECONDS=90
SANDBOX_VERIFY_TIMEOUT_SECONDS=180

# ---- 模型 ----
# 留空时 llmProvider=auto 回退 Mock；填入真实 Key 后重建 python-ai：
#   docker compose up -d --force-recreate python-ai
# 前端模型选择器可选「自动（有 Key 用 DeepSeek）」/「DeepSeek」/「Mock」。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
