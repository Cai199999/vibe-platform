# ============================================================
# vibe-platform 本地开发环境变量
# 复制为 .env 后按需修改；.env 不提交 Git
# ============================================================

# ---- 运行环境 ----
APP_ENV=local

# ---- MySQL（复用 ~/Workspace/infra 的 Docker 实例） ----
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=geo_ai_db
MYSQL_USER=root
MYSQL_PASSWORD=root
# L3 生产级：真实 MySQL 迁移验收（临时库执行 DDL，绝不触碰业务库）。
QUALITY_MYSQL_VERIFY_ENABLED=true
QUALITY_MYSQL_TIMEOUT_SECONDS=8

# ---- Redis（复用 ~/Workspace/infra 的 Docker 实例） ----
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- MinIO（复用 ~/Workspace/infra 的 Docker 实例） ----
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=vibe-platform
MINIO_SECURE=false

# ---- AI Core ----
AI_CORE_BASE_URL=http://python-ai:8100
AI_CORE_CONNECT_TIMEOUT_MS=2000
AI_CORE_READ_TIMEOUT_MS=3000
# Run 同步执行：模型 + 沙盒构建 + 最多 3 次修复。
AI_CORE_RUN_CONNECT_TIMEOUT_MS=2000
AI_CORE_RUN_READ_TIMEOUT_MS=300000

# ---- Sandbox ----
# 宿主 docker 组 GID：Linux 执行 `stat -c '%g' /var/run/docker.sock` 获取。
# Docker Desktop / Windows 通常无需修改，保持 0 以外的默认值即可。
DOCKER_GID=115
SANDBOX_IMAGE=vibe-platform/sandbox-react:dev
# 浏览器访问预览端口时使用的主机名；M1 单机本地开发用 127.0.0.1。
SANDBOX_PREVIEW_HOST=127.0.0.1
# Phase 0 草稿隔离：每个沙盒同时发布主预览 5173 与草稿预览 5174。
SANDBOX_DEV_PORT=5173
SANDBOX_DRAFT_PORT=5174
SANDBOX_DRAFT_ROOT=/app-drafts
SANDBOX_DRAFT_START_TIMEOUT_SECONDS=90
# 孤儿草稿回收：python-ai 重启后，容器内残留的 worktree / 预览进程
# 超过 TTL 且未被当前进程登记时自动清理。TTL<=0 表示停用回收。
SANDBOX_DRAFT_ORPHAN_TTL_DAYS=7
SANDBOX_DRAFT_GC_ENABLED=true
# 启动时立即回收一次，之后每 6 小时检查一次。
SANDBOX_DRAFT_GC_INTERVAL_SECONDS=21600
SANDBOX_MEMORY_MB=768
SANDBOX_CPU_LIMIT=1.0
# Direct Ops / AI Run 共享的项目级写锁。
# AI promote / fullstack 等待上限（秒）；Direct Ops 超时快速失败。
PROJECT_WRITE_LOCK_TIMEOUT_SECONDS=30
DIRECT_OPS_LOCK_TIMEOUT_SECONDS=3
DIRECT_OPS_CHANGELOG_LIMIT=200
DIRECT_OPS_CHANGELOG_PATH=data/changelog.jsonl
SANDBOX_START_TIMEOUT_SECONDS=90
SANDBOX_VERIFY_TIMEOUT_SECONDS=180

# ---- 模型 ----
# 留空时 llmProvider=auto 回退 Mock；填入真实 Key 后重建 python-ai：
#   docker compose up -d --force-recreate python-ai
# 前端模型选择器可选「自动（有 Key 用 DeepSeek）」/「DeepSeek」/「Mock」。
DEEPSEEK_API_KEY=
# 全栈 BackendCoder LLM 自愈：模板为默认路径；仅当 Applier AST 门禁
# 判为 CODE_DEFECT 或一致性要求重建 JOIN 时，才把诊断反馈交给 LLM。
# 设为 false 可完全退化为确定性模板（离线 / 零模型成本）。
FULLSTACK_LLM_REPAIR_ENABLED=true
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Token 成本优化 ----
# 能力分级：FAST 用于摘要 / 路由 / 校验 / Planner，STRONG 用于 Coder / 契约。
# 留空回退 DEEPSEEK_MODEL。若接入更便宜的模型，可只改 FAST 档。
MODEL_FAST_NAME=deepseek-chat
MODEL_STRONG_NAME=deepseek-chat
MODEL_FAST_TEMPERATURE=0.0
MODEL_STRONG_TEMPERATURE=0.2
# Coder / BackendCoder 修复输出完整文件（JSON 字符串），默认 4096 易截断。
CODER_MAX_OUTPUT_TOKENS=8192
# 确定性节点：Planner / Architect 固定低温度，避免随机反问。
MODEL_PLANNER_TEMPERATURE=0.1
MODEL_ARCHITECT_TEMPERATURE=0.1
# 任务级覆盖（优先级最高，留空表示使用所属层级）
MODEL_ROUTING_NAME=
MODEL_VALIDATION_NAME=
MODEL_SUMMARY_NAME=
# 用户消息意图分级（高优需求 / 约束 vs 低优闲聊）
MODEL_INTENT_NAME=
MODEL_PLANNER_NAME=
MODEL_CODER_NAME=
MODEL_ARCHITECT_ANALYZE_NAME=
MODEL_ARCHITECT_CONTRACT_NAME=
# 分层历史压缩：超过阈值后，最近 N 轮原文保留，旧消息按意图分级摘要。
HISTORY_SUMMARY_TOKEN_THRESHOLD=3000
HISTORY_SUMMARY_MAX_CHARS=200
HISTORY_RECENT_TURNS=10
# 每 N 轮生成一次 local_summary.md；保存快照时汇总为 global/user_profile。
HISTORY_LOCAL_SUMMARY_INTERVAL=10
HISTORY_LOCAL_SUMMARY_MAX_CHARS=600
CONTEXT_TOKEN_ENCODING=cl100k_base
CONTEXT_MEMORY_DIR=data/project_memory
CONTEXT_GLOBAL_SUMMARY_MAX_CHARS=1200
CONTEXT_USER_PROFILE_MAX_CHARS=600
# 工具完整结果落盘，Prompt 只保留预览 + sha256。
TOOL_OUTPUT_PREVIEW_CHARS=2000
# 构建失败只回传 Error Message + 报错行前后 N 行代码
ERROR_CONTEXT_LINES=10
ERROR_CONTEXT_MAX_CHARS=2000
# Reflection：同一实现偏好累计 N 次成功后作为默认值（默认 2）
AGENT_PREFERENCE_MIN_EVIDENCE=2

# ---- Agent 结构化输出自修复 ----
# Planner / Coder 输出非法 JSON、缺目标文件或空 patch 时，把原始输出与
# 校验错误回传模型重试；0 表示关闭。
AGENT_JSON_RETRY_LIMIT=1
# Coder 节点硬超时（秒）；超时直接 FAILED，不进入构建自愈循环。
AGENT_CODER_TIMEOUT_SECONDS=30

# ---- Token 成本核算 ----
# 价格单位：货币金额 / 100 万 tokens；不填使用内置 DeepSeek 目录价。
# 示例：LLM_PRICING={"deepseek-chat":{"input":2,"cached_input":0.5,"output":8}}
LLM_PRICING={}
LLM_COST_CURRENCY=CNY

# ---- M2.5 全局架构澄清 ----
# 请求级 options 可覆盖以下默认值；这里配置服务端兜底。
ARCHITECT_CONFIDENCE_THRESHOLD=0.85
ARCHITECT_MAX_CLARIFICATION_ROUNDS=10
ARCHITECT_CONTRACT_REPAIR_LIMIT=1
# 强制 JSON Output；Pydantic 校验失败时把错误回传模型重试（最多 2 次）。
ARCHITECT_STRUCTURED_OUTPUT=true
ARCHITECT_JSON_RETRY_LIMIT=2
# 契约 + 完整 VisualDocument 单次输出上限；DeepSeek 默认 4096 易截断。
ARCHITECT_MAX_OUTPUT_TOKENS=8192
# Architect 连接级瞬态错误重试（流式中断 / 502 / 超时）；默认 2。
ARCHITECT_LLM_RETRY_LIMIT=2
# 混合 RAG：hybrid = BM25（硬性规范）+ Chroma（企业长文档）+ RRF。
# 只回退到单一通道时才设为 markdown / chroma。
ARCHITECT_RAG_PROVIDER=hybrid
ARCHITECT_RAG_TOP_K=5
ARCHITECT_KNOWLEDGE_DIR=knowledge/fullstack
# 企业长文档目录与本地向量库持久化目录（挂载在 /app/data 下）。
ENTERPRISE_KNOWLEDGE_DIR=knowledge/enterprise_docs
# Hybrid 在同一语料上双路召回：knowledge/ 含 fullstack 规范 + enterprise_docs。
RAG_KNOWLEDGE_ROOT=knowledge
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=enterprise_docs
CHROMA_HYBRID_COLLECTION_NAME=knowledge_corpus
RAG_HYBRID_RRF_K=60
RAG_HYBRID_CANDIDATE_MULTIPLIER=3
# 预留：空 = Chroma 内置 ONNX MiniLM；切换 BGE-M3 时由适配器注入对应
# EmbeddingFunction，并新建 collection（维度不同，禁止复用旧索引）。
# 注意与 M3 Knowledge Service 的 KNOWLEDGE_EMBEDDING_MODEL 区分。
EMBEDDING_MODEL=
# Planner 侧召回数量：计划 Prompt 预算更紧，默认 3。
AGENT_RAG_TOP_K=3
ARCHITECT_SOURCE_MAX_BYTES=200000
ARCHITECT_SOURCE_MAX_FILES=80

# ---- M2.5 Supervisor 多智能体总调度 ----
# 只扫描 *.json Manifest，不执行代码；目录不存在时仅记录日志。
SUPERVISOR_CUSTOM_AGENTS_DIR=config/custom_agents

# ---- 项目导入（M3）----
# zip 包与图片上传限制；超限直接 413，避免解压炸弹与内存打满。
IMPORT_MAX_ARCHIVE_BYTES=33554432
IMPORT_MAX_IMAGE_BYTES=12582912
IMPORT_MAX_UNCOMPRESSED_BYTES=134217728
IMPORT_MAX_ENTRIES=4000
SANDBOX_IMPORT_TIMEOUT_SECONDS=300

# ---- 图片导入视觉模型 ----
# OpenAI 兼容多模态端点。留空时图片导入走确定性占位页（仍可编译），
# 填入后才会真正识别截图结构并生成 React 代码。
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o
VISION_TIMEOUT_SECONDS=90
VISION_MAX_IMAGE_SIDE=1600

# ---- Agent 扩展：Skills / Tools / MCP（M3）----
SKILLS_DIR=config/skills
# shell_tool 默认关闭；即使打开也只允许只读白名单命令（pwd/ls/node -v 等）。
TOOL_SHELL_ENABLED=false
TOOL_SHELL_WORKDIR=/tmp/vibe-toolbox
TOOL_SHELL_TIMEOUT_SECONDS=10
TOOL_SHELL_MAX_OUTPUT_CHARS=20000
# DuckDuckGo 搜索 Tool：无密钥、只读；关闭后仍注册但调用返回禁用提示。
TOOL_WEB_SEARCH_ENABLED=true
TOOL_WEB_SEARCH_TIMEOUT_SECONDS=8
TOOL_WEB_SEARCH_MAX_RESULTS=5
# 外部 MCP Server 列表（JSON 数组）。
# 启用前先在镜像内安装官方 mcp SDK：pip install mcp。
# 示例：[{"name":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
MCP_ENABLED=true
MCP_CALL_TIMEOUT_SECONDS=10
# 本地示例：python-ai 容器通过 ./scripts:/app/scripts:ro 挂载看到脚本。
MCP_SERVERS=[{"name":"vibe_demo","transport":"stdio","command":"python","args":["/app/scripts/mcp_server_demo.py"],"cwd":"/app","enabled":true,"allowed_tools":["get_current_time"]}]

# ---- M3 数据中台 Knowledge Service（契约预留，当前未实现）----
# 当前由本地 Hybrid RAG（BM25 + Chroma）承载；重型 Knowledge Service 未接入。
ARCHITECT_RAG_PROVIDER=hybrid
KNOWLEDGE_SERVICE_BASE_URL=http://knowledge-service:8300/internal/v1
KNOWLEDGE_SERVICE_TOKEN=
KNOWLEDGE_SERVICE_TIMEOUT_MS=3000
KNOWLEDGE_SERVICE_CONNECT_TIMEOUT_MS=500
ARCHITECT_RAG_REQUIRE_TENANT=true
ARCHITECT_RAG_ALLOW_LOCAL_FALLBACK=true
KNOWLEDGE_EMBEDDING_MODEL=bge-m3
KNOWLEDGE_EMBEDDING_BASE_URL=http://embedding:8400
KNOWLEDGE_RERANK_ENABLED=true
KNOWLEDGE_MAX_DOCUMENT_BYTES=52428800
KNOWLEDGE_MAX_TOP_K=20
KNOWLEDGE_RETENTION_DAYS=90
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ---- M3 管理中台 / Prompt 自优化（契约预留，当前未实现）----
PROMPT_REGISTRY_ENABLED=true
PROMPT_OPTIMIZATION_ENABLED=false
PROMPT_OPTIMIZATION_CRON=0 2 * * 1
PROMPT_OPTIMIZATION_MIN_SAMPLES=20
PROMPT_CANARY_DEFAULT_PERCENT=10
FEEDBACK_COLLECTOR_ENABLED=true
ADMIN_METRICS_REFRESH_SECONDS=60
