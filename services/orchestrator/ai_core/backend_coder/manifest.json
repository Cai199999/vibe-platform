      "files": {
        "type": "object",
        "additionalProperties": {"type": "string"}
      },
      "options": {"type": "object"}
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "BackendCoderOutput",
    "type": "object",
    "required": ["runId", "status", "files"],
    "properties": {
      "runId": {"type": "string"},
      "status": {
        "type": "string",
        "enum": ["SUCCEEDED", "FAILED", "CANCELLED"]
