{
  "agent_id": "backend_coder",
  "name": "后端工程师",
  "description": "根据已确认的实施契约生成 Node/Express 后端路由与接口实现，并通过 FullstackGraph 的 backend 子图执行构建与重启。",
  "version": "1.0.0",
  "status": "available",
  "graph": "BackendCoderGraph",
  "capabilities": [
    {
      "id": "backend_generation",
      "description": "读取《全栈实施契约》，按技术栈生成 Controller / Service / Repository 或 FastAPI Router / Service / Repository 与测试。"
    },
    {
      "id": "api_contract_implementation",
      "description": "把契约中的 API 路由、请求响应模型、状态码与错误码落地为可运行接口，并回写实现清单。"
    }
  ],
  "supported_tools": [
    "read_contract",
    "read_file",
    "create_file",
    "apply_code_edit",
    "run_maven_test",
    "run_pytest",
    "git_commit"
  ],
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "BackendCoderInput",
    "type": "object",
    "required": ["projectId", "contract"],
    "properties": {
      "projectId": {"type": "string"},
      "contract": {"type": "object"},
      "stack": {
        "type": "string",
        "enum": ["spring_boot", "fastapi"],
        "default": "spring_boot"
      },
      "sandboxId": {"type": ["string", "null"]},
      "files": {
        "type": "object",
        "additionalProperties": {"type": "string"}
      },
      "options": {"type": "object"}
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "BackendCoderOutput",
    "type": "object",
    "required": ["runId", "status", "files"],
    "properties": {
      "runId": {"type": "string"},
      "status": {
        "type": "string",
        "enum": ["SUCCEEDED", "FAILED", "CANCELLED"]
      },
      "files": {
        "type": "object",
        "additionalProperties": {"type": "string"}
      },
      "testReport": {"type": ["object", "null"]},
      "endpointManifest": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "method": {"type": "string"},
            "path": {"type": "string"},
            "handler": {"type": "string"}
          }
        }
      },
      "commitHash": {"type": ["string", "null"]}
    }
  },
  "skills": [
    {
      "skill_id": "backend.spring_boot_crud",
      "name": "Spring Boot CRUD 生成",
      "description": "按契约中的实体与 API 路由生成 Controller / Service / Repository 分层代码和单元测试。",
      "prompt_ref": "prompts/backend/spring_boot_crud.md",
      "rag_refs": ["knowledge/backend/spring"],
      "tools": ["read_contract", "create_file", "run_maven_test"],
      "metadata": {"stage": "M3-preview"}
    },
    {
      "skill_id": "backend.fastapi_crud",
      "name": "FastAPI CRUD 生成",
      "description": "按契约生成 FastAPI Router / Service / SQLAlchemy Repository，并补齐 pytest 用例。",
      "prompt_ref": "prompts/backend/fastapi_crud.md",
      "rag_refs": ["knowledge/backend/fastapi"],
      "tools": ["read_contract", "create_file", "run_pytest"],
      "metadata": {"stage": "M4-preview"}
    },
    {
      "skill_id": "backend.db_migration",
      "name": "数据库迁移生成",
      "description": "根据契约 DDL 生成 Flyway / Alembic 迁移并验证 up / down。",
      "prompt_ref": "prompts/backend/db_migration.md",
      "rag_refs": ["knowledge/backend/mysql"],
      "tools": ["read_contract", "create_file", "run_maven_test", "run_pytest", "git_commit"],
      "metadata": {"stage": "M3-preview"}
    },
    {
      "skill_id": "backend.api_test",
      "name": "接口测试生成",
      "description": "为每个契约路由生成正常、边界与错误码用例，输出可重复执行的测试报告。",
      "prompt_ref": "prompts/backend/api_test.md",
      "rag_refs": ["knowledge/backend/testing"],
      "tools": ["read_contract", "create_file", "run_maven_test", "run_pytest"],
      "metadata": {"stage": "M3-preview"}
    },
    {
      "skill_id": "production.ready",
      "name": "生产级后端基线",
      "description": "强制环境变量隔离、SQL 迁移、参数化查询、严格 CORS、真实健康检查与多阶段镜像；挂载自 config/skills/production_ready.skill.md。",
      "prompt_ref": "production_ready.skill.md",
      "rag_refs": [],
      "tools": ["read_file", "create_file", "apply_code_edit"],
      "metadata": {"stage": "production", "priority": 10, "mandatory": true}
    },
    {
      "skill_id": "web.best_practices",
      "name": "Web 开发规范与安全编码",
      "description": "强制 RESTful 资源设计、统一错误码、ORM 参数化查询、Bcrypt 密码哈希、输入校验与密钥隔离；挂载自 config/skills/web_best_practices.skill.md。",
      "prompt_ref": "web_best_practices.skill.md",
      "rag_refs": [],
      "tools": ["read_file", "create_file", "apply_code_edit"],
      "metadata": {"stage": "production", "priority": 20, "mandatory": true}
    }
  ],
  "keywords": [
    "后端代码",
    "restful",
    "api",
    "spring boot",
    "fastapi",
    "controller",
    "service",
    "repository",
    "实体类"
  ],
  "metadata": {
    "manifest_version": 1,
    "owner": "platform",
    "contract_only": false,
    "activation": "M3-active",
    "dispatch_mode": "backend",
    "dispatch_graph": "fullstack"
  }
}
